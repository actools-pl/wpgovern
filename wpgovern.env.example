# =============================================================================
# wpgovern.env.example — WPGovern Installer Environment Template
#
# Copy this file to wpgovern.env and fill in your values.
#   cp wpgovern.env.example wpgovern.env
#   chmod 600 wpgovern.env
#   $EDITOR wpgovern.env
#
# SECURITY: wpgovern.env contains secrets. Never commit it to source control.
# It is gitignored by default. The example file contains no real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Core configuration
# -----------------------------------------------------------------------------

# Operator email address.
# Used by: logrotate (mail-on-error), future audit notifications.
# Must be a valid RFC 5322 email address.
WPGOVERN_OPERATOR_EMAIL="operator@example.com"

# -----------------------------------------------------------------------------
# OPTIONAL: Paths (defaults are sensible for Hetzner CX22)
# -----------------------------------------------------------------------------

# Root directory for all WPGovern artifacts: state file, Docker Compose files,
# WordPress data, config files.
# Default: /opt/wpgovern
# WPGOVERN_INSTALL_DIR="/opt/wpgovern-install"
# (Default if unset. Must equal /opt/wpgovern-install for H.5 byte-one ceremony.)

# Directory for installer log files.
# Default: /var/log/wpgovern-installer
# WPGOVERN_LOG_DIR="/var/log/wpgovern-installer"

# State file path.
# Default: $WPGOVERN_INSTALL_DIR/.wpgovern-installer-state.json
# WPGOVERN_STATE_FILE="/opt/wpgovern/.wpgovern-installer-state.json"

# -----------------------------------------------------------------------------
# OPTIONAL: Host phase tuning
# -----------------------------------------------------------------------------

# Swap file size in megabytes.
# Default: 2048 (2GB, appropriate for CX22 with 4GB RAM).
# Increase for CX32 (8GB RAM) or higher.
# WPGOVERN_SWAP_SIZE_MB="2048"

# SSH port to verify before enabling UFW (default: 22).
# Change this if your Hetzner server uses a non-standard SSH port.
# WPGOVERN_SSH_PORT="22"

# Note: --force-firewall is a CLI-only flag for one-time safety bypass.
# It cannot be set via env file. To skip the SSH safety check on a specific run:
#   sudo ./wpgovern-install.sh --env-file <file> --force-firewall

# -----------------------------------------------------------------------------
# Future phases (H.2+) will add variables here:
# H.2: WPGOVERN_DOMAIN, image digest pins
# H.3: Database credentials (generated, not set manually)
# H.4: WordPress admin credentials (generated, not set manually)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Stack phase variables (H.2+)
# -----------------------------------------------------------------------------

# Domain for HTTPS via Let's Encrypt. Required for stack phase.
# Must resolve to this server's public IP for LE to issue a cert.
# WPGOVERN_DOMAIN="example.com"

# Let's Encrypt registration email. Defaults to WPGOVERN_OPERATOR_EMAIL.
# WPGOVERN_LE_EMAIL=""

# Database credentials. LEAVE BLANK on first install — the installer generates
# strong passwords and writes them back to this file. On subsequent runs, the
# persisted values are read back, never regenerated.
# WPGOVERN_DB_ROOT_PASSWORD=""
# WPGOVERN_DB_WP_PASSWORD=""

# Backup database user password. LEAVE BLANK on first install — the installer
# generates a strong password and writes it back to this file. Subsequent runs
# read the persisted value and never regenerate.
# Allowed characters: A-Za-z0-9._@%- (24-128 chars)
# WPGOVERN_DB_BACKUP_PASSWORD=""

# -----------------------------------------------------------------------------
# WordPress provisioning variables (H.4+)
# -----------------------------------------------------------------------------

# WordPress admin credentials. Required for initial installation.
# WPGOVERN_WP_ADMIN_USER=""       # Must match ^[a-z][a-z0-9_-]{2,30}$
# WPGOVERN_WP_ADMIN_PASSWORD=""   # Required; use a strong password
# WPGOVERN_WP_ADMIN_EMAIL=""      # Required; valid email address
# WPGOVERN_WP_SITE_TITLE=""       # Optional; default: "WPGovern Site"

# WordPress authentication keys and salts.
# LEAVE BLANK on first install — the installer generates 64-char hex values via
# openssl rand -hex 32 and writes them back to this file. Subsequent runs use the
# persisted values, producing byte-identical wp-config.php (required for H.5 signing).
# WPGOVERN_WP_AUTH_KEY=""
# WPGOVERN_WP_SECURE_AUTH_KEY=""
# WPGOVERN_WP_LOGGED_IN_KEY=""
# WPGOVERN_WP_NONCE_KEY=""
# WPGOVERN_WP_AUTH_SALT=""
# WPGOVERN_WP_SECURE_AUTH_SALT=""
# WPGOVERN_WP_LOGGED_IN_SALT=""
# WPGOVERN_WP_NONCE_SALT=""

# -----------------------------------------------------------------------------
# WordPress provisioning variables (H.4)
# -----------------------------------------------------------------------------

# Admin account — REQUIRED before first install
# WPGOVERN_WP_ADMIN_USER="admin"          # lowercase, 3-30 chars, [a-z0-9_-]
# WPGOVERN_WP_ADMIN_PASSWORD=""           # ≥24 chars, safe ASCII
# WPGOVERN_WP_ADMIN_EMAIL=""              # valid email address
# WPGOVERN_WP_SITE_TITLE="WPGovern Site"  # site display name (≤100 chars)

# WordPress authentication keys/salts.
# LEAVE BLANK on first install — the installer generates 64-char hex values
# and writes them back to this file. Subsequent runs read the persisted values
# and never regenerate (same discipline as DB passwords in H.2).
# WPGOVERN_WP_AUTH_KEY=""
# WPGOVERN_WP_SECURE_AUTH_KEY=""
# WPGOVERN_WP_LOGGED_IN_KEY=""
# WPGOVERN_WP_NONCE_KEY=""
# WPGOVERN_WP_AUTH_SALT=""
# WPGOVERN_WP_SECURE_AUTH_SALT=""
# WPGOVERN_WP_LOGGED_IN_SALT=""
# WPGOVERN_WP_NONCE_SALT=""

# -----------------------------------------------------------------------------
# Ceremony phase variables (H.5+)
# -----------------------------------------------------------------------------

# Governance actor identity for the byte-one ceremony.
# Default: "installer". Can be set to an email-like value for audit traceability.
# Allowed: ^[a-zA-Z][a-zA-Z0-9_.@-]{0,63}$
# WPGOVERN_ACTOR_ID="installer"

# Governance reason recorded in the byte-one approval record.
# Default: "byte-one bootstrap". ≤200 printable chars.
# WPGOVERN_CEREMONY_REASON="byte-one bootstrap"

# -----------------------------------------------------------------------------
# Backup phase variables (H.7)
# -----------------------------------------------------------------------------

# Database password for the backup user (read-only + SHOW MASTER STATUS).
# Required for backup and restore operations.
# WPGOVERN_DB_BACKUP_PASSWORD="generated-at-install-time"

# Path to the age private key (mode 0600, operator-owned).
# DEFAULT: /etc/wpgovern/age.key
# WPGOVERN_AGE_PRIVATE_KEY_PATH="/etc/wpgovern/age.key"

# Path to the age public key (mode 0644).
# DEFAULT: /etc/wpgovern/age.pub
# WPGOVERN_AGE_PUBLIC_KEY_PATH="/etc/wpgovern/age.pub"

# Directory where backup files are stored.
# DEFAULT: /srv/wpgovern/backups
# WPGOVERN_BACKUP_DIR="/srv/wpgovern/backups"

# Optional: rclone remote for offsite backup sync (e.g., "s3remote:mybucket/wpgovern").
# If unset, backups remain local only.
# WPGOVERN_RCLONE_REMOTE=""
